generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ADMIN (separate table — maximum security)
// ============================================================

model Admin {
  id             String         @id @default(cuid())
  email          String         @unique
  passwordHash   String
  totpSecret     String?
  totpEnabled    Boolean        @default(false)
  lastLoginAt    DateTime?
  lastLoginIp    String?
  failedAttempts Int            @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  auditLogs      AuditLog[]
  sessions       AdminSession[]

  @@map("admins")
}

model AdminSession {
  id        String   @id @default(cuid())
  adminId   String
  admin     Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipAddress String
  userAgent String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

// ============================================================
// USERS (invited members)
// ============================================================

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  username     String      @unique

  inviteCodeId String?     @unique
  inviteCode   InviteCode? @relation(fields: [inviteCodeId], references: [id])

  emailVerified Boolean   @default(false)
  verifyToken   String?   @unique
  verifyExpires DateTime?

  resetToken   String?   @unique
  resetExpires DateTime?

  failedAttempts Int       @default(0)
  lockedUntil    DateTime?

  lastLoginAt DateTime?
  lastLoginIp String?

  status    UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       UserSession[]
  inquiries      Inquiry[]
  watchlistItems WatchlistItem[]

  @@index([email])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  ipAddress String
  userAgent String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// ============================================================
// INVITE CODES (generated by admin)
// ============================================================

model InviteCode {
  id               String    @id @default(cuid())
  codeHash         String    @unique
  codePrefix       String
  label            String?
  notes            String?
  used             Boolean   @default(false)
  usedAt           DateTime?
  usedByUserId     String?   @unique
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  createdByAdminId String

  user User?

  @@index([codePrefix])
  @@index([used])
  @@map("invite_codes")
}

// ============================================================
// LISTINGS
// ============================================================

model Listing {
  id String @id @default(cuid())

  // Public teaser (visible without login)
  teaserTitle       String
  teaserDescription String  @db.Text
  teaserImageUrl    String

  // Member data (visible with login) — NO concrete vehicle images
  brand             String
  model             String
  year              Int

  engineDisplacement Int?
  enginePower        Int?
  acceleration       Float?
  topSpeed           Int?

  mileageRange    String?
  conditionRating ConditionRating

  priceRangeMin Decimal? @db.Decimal(12, 2)
  priceRangeMax Decimal? @db.Decimal(12, 2)
  priceCurrency String   @default("EUR")

  generalDescription String   @db.Text
  highlights         String[]

  // Admin-only (NEVER sent to frontend)
  internalNotes      String? @db.Text
  internalSellerInfo String? @db.Text

  status      ListingStatus @default(DRAFT)
  publishedAt DateTime?

  viewCount    Int @default(0)
  inquiryCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images         ListingImage[]
  inquiries      Inquiry[]
  watchlistItems WatchlistItem[]

  @@index([status, publishedAt])
  @@index([brand, model])
  @@map("listings")
}

enum ConditionRating {
  CONCOURS
  EXCELLENT
  VERY_GOOD
  GOOD
  RESTORATION
}

enum ListingStatus {
  DRAFT
  ACTIVE
  RESERVED
  SOLD
  WITHDRAWN
}

model ListingImage {
  id           String   @id @default(cuid())
  listingId    String
  listing      Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  width        Int
  height       Int
  caption      String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([listingId])
  @@map("listing_images")
}

// ============================================================
// INQUIRIES
// ============================================================

model Inquiry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type InquiryType

  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])

  vehicleBrand    String?
  vehicleModel    String?
  vehicleYear     Int?
  vehicleMileage  Int?
  vehicleVin      String?
  vehicleLocation String?

  message          String        @db.Text
  contactPhone     String?
  preferredContact ContactMethod @default(EMAIL)

  status     InquiryStatus @default(NEW)
  adminNotes String?       @db.Text

  respondedAt DateTime?
  closedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([listingId])
  @@index([status])
  @@index([createdAt])
  @@map("inquiries")
}

enum InquiryType {
  LISTING_INQUIRY
  ASSESSMENT_REQUEST
  GENERAL
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
  ARCHIVED
}

enum ContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}

// ============================================================
// WATCHLIST
// ============================================================

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@map("watchlist_items")
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String  @id @default(cuid())
  adminId   String?
  admin     Admin?  @relation(fields: [adminId], references: [id])
  action    String
  entityType String?
  entityId  String?
  ipAddress String
  userAgent String
  details   Json?
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// RATE LIMITING
// ============================================================

model RateLimit {
  id          String   @id @default(cuid())
  identifier  String
  action      String
  count       Int      @default(1)
  windowStart DateTime @default(now())

  @@unique([identifier, action])
  @@index([windowStart])
  @@map("rate_limits")
}
