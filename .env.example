# ──────────────────────────────────────────────────────────────────────────────
# Off-Market Automobiles — Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local!
# ──────────────────────────────────────────────────────────────────────────────

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/offmarketdealer"

# JWT Secrets — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ADMIN_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CSRF
CSRF_SECRET=""

# Bcrypt
BCRYPT_ROUNDS="12"

# Admin setup
ADMIN_PATH_SECRET="admin-panel"   # Change to something random like "admin-7f3a8b2c"
ADMIN_INITIAL_EMAIL=""            # Used only for prisma/seed.ts
ADMIN_INITIAL_PASSWORD=""         # Used only for prisma/seed.ts
ADMIN_EMAIL=""                    # Where inquiry notifications go

# Email (Resend)
EMAIL_FROM="kontakt@ihre-domain.de"
RESEND_API_KEY=""

# File uploads
UPLOAD_DIR="/var/www/offmarketdealer/uploads"  # Outside web root!
MAX_FILE_SIZE_MB="10"

# Security
ALLOWED_ORIGINS="https://ihre-domain.de"
RATE_LIMIT_LOGIN_MAX="5"
RATE_LIMIT_LOGIN_WINDOW_MIN="15"

# App
NEXT_PUBLIC_APP_URL="https://ihre-domain.de"
NODE_ENV="production"

# Sentry (optional — error monitoring)
# SENTRY_DSN=""
